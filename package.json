{
  "name": "brand-foundry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A forkable, local-first template studio: author HTML templates, fill them in a browser UI, export branded PNGs and video.",
  "scripts": {
    "setup": "node setup.mjs",
    "doctor": "node doctor.mjs",
    "build": "node generate.mjs",
    "start": "node generate.mjs && node server.mjs",
    "serve": "node server.mjs",
    "clean": "node -e \"require('fs').rmSync('.cache',{recursive:true,force:true});require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "puppeteer-core": "^25.3.0"
  },
  "optionalDependencies": {
    "hyperframes": "^0.8.34"
  },
  "engines": {
    "node": ">=22"
  }
}
